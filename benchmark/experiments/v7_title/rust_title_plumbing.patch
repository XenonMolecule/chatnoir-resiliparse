+/// Page-title token set (cycle 0170), hashed identically to the block
+/// scanner: FNV-1a over lowercased bytes of whitespace-delimited runs.
+unsafe fn title_token_set(doc: *mut lxb_html_document_t) -> HashSet<u64> {
+    unsafe {
+        let mut set = HashSet::new();
+        let t = doc_title(doc);
+        let mut wh: u64 = 0xcbf29ce484222325;
+        let mut in_word = false;
+        for &b in t.iter() {
+            if c_isspace(b) {
+                if in_word { set.insert(wh); wh = 0xcbf29ce484222325; }
+                in_word = false;
+            } else {
+                wh ^= b.to_ascii_lowercase() as u64;
+                wh = wh.wrapping_mul(0x100000001b3);
+                in_word = true;
+            }
+        }
+        if in_word { set.insert(wh); }
+        set
+    }
+}
